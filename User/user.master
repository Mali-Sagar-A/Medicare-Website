<%@ Master Language="C#" AutoEventWireup="true" CodeFile="user.master.cs" Inherits="User_user" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            width: 100%;
        }
        .valig{
            vertical-align: top;
        }
        .search{
            border:1px solid;
            border-radius:10px; 
        }
    </style>
   <link rel="stylesheet" type="text/css" href="../engine1/style.css" />
	<script type="text/javascript" src="../engine1/jquery.js"></script>

</head>
<body>
    <form id="form1" runat="server">
    <div>
        <table cellpadding="5" class="auto-style1" align="cneter">
            <tr>
                <td>
                    <asp:Image ID="Image1" runat="server" Height="80px" ImageUrl="~/Images/logo.png" Width="260px" />
                </td>
                <td>
                    <table cellpadding="0" cellspacing="0" class="search">
                        <tr>
                            <td style="text-align: right">
                                &nbsp;<asp:TextBox ID="TextBox1" runat="server" Height="31px" Width="213px" BorderStyle="None"></asp:TextBox>
                            </td>
                            <td>
                                <asp:ImageButton ID="ImageButton1" runat="server" Height="31px" ImageUrl="~/Images/Search.png" Width="46px" OnClick="ImageButton1_Click" />
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="font-family: sans-serif; font-size: 20px; font-weight: 400;">
                     <table cellpadding="0" cellspacing="0">
                        <tr>
                            <td >
                                <asp:Image ID="Image2" runat="server" Height="40px" ImageUrl="~/Images/user.png" Width="40px" />
                            </td>
                            <td style="font-family: sans-serif; font-size: 20px; font-weight: 400">
                                 <asp:HyperLink ID="HyperLink1" Font-Underline="false" runat="server" ForeColor="Black" NavigateUrl="~/User/Login.aspx">Sign In</asp:HyperLink>
&nbsp;/
                    <asp:HyperLink ID="HyperLink2" Font-Underline="false" runat="server" ForeColor="Black" NavigateUrl="~/User/Registration.aspx">Sign Up</asp:HyperLink>
                
                            </td>
                        </tr>
                    </table>
                    
                   </td>
            </tr>
            <tr>
                <td colspan="3">
                    <asp:Menu ID="Menu1" runat="server" Orientation="Horizontal" RenderingMode="Table" Width="100%" BackColor="#339966" ForeColor="White" Height="35px" style="text-align: center;text-align: center; font-family: sans-serif; font-size: 20px; font-weight: 400">
                        <Items>
                            <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/User/Home.aspx"></asp:MenuItem>
                            <asp:MenuItem Text="About Us" Value="About Us" NavigateUrl="~/User/Aboutus.aspx"></asp:MenuItem>
                            <asp:MenuItem Text="Product" Value="Product" NavigateUrl="~/User/Product.aspx"></asp:MenuItem>
                            <asp:MenuItem Text="Enquiry" Value="Enquiry" NavigateUrl="~/User/Enquiry.aspx"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/User/Contactus.aspx" Text="Contact Us" Value="Contact Us"></asp:MenuItem>
                        </Items>
                    </asp:Menu>
                </td>
            </tr>
            <tr>
                <td colspan="3" style="text-align: center">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
            <tr>
                <td colspan="3" >
                    <marquee scrollamount ="10" style="background-color: #339966; color:white; text-align: center; font-family: sans-serif; font-size: 20px; font-weight: 400" behaviour ="alternate">Project By Sagar & Shubham <asp:Button ID="Button1" runat="server" Text="b" AccessKey="b" style="background-color: #339966; color:#339966" BorderStyle="None" PostBackUrl="~/Admin/Adminlogin.aspx" Visible="True" /></marquee>
                    
                    </td>
            </tr>
        </table>
    </div>
    </form>
</body>
</html>
