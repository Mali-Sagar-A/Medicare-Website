<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Customer.master.cs" Inherits="Customer_Customer" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            width: 100%;
        }
        .search{
            border:1px solid;
            border-radius:10px; 
        }
    </style>
    <link rel="stylesheet" type="text/css" href="../engine1/style.css" />
	<script type="text/javascript" src="../engine1/jquery.js"></script>
</head>
<body>
    <form id="form1" runat="server">
    <div>
        <table class="auto-style1">
                <tr>
                <td rowspan="2">
                    <asp:Image ID="Image1" runat="server" Height="90px" ImageUrl="~/Images/logo.png" Width="275px" />
                </td>
                    <td rowspan="2">
                        &nbsp;
                        
                    <table cellpadding="0" cellspacing="0" class="search">
                        <tr>
                            <td style="text-align: right">
                                &nbsp;<asp:TextBox ID="TextBox1" runat="server" Height="31px" Width="213px" BorderStyle="None"></asp:TextBox>
                            </td>
                            <td>
                                <asp:ImageButton ID="ImageButton1" runat="server" Height="31px" ImageUrl="~/Images/Search.png" Width="46px" OnClick="ImageButton1_Click"  />
                            </td>
                        </tr>
                    </table>
                
                    </td>
                    <td style="text-align: right">
                        <asp:Image ID="Image2" runat="server" Height="40px" ImageUrl="~/Images/user.png" Width="40px" />
                
                    </td>
                    <td style="font-family: sans-serif; font-size: 20px; font-weight: 400;">
                        <asp:Label ID="Label1" runat="server" Text="Label"></asp:Label>
                
                    </td>
                </tr>
                <tr>
                    <td style="text-align: center">
                        <asp:ImageButton ID="ImageButton2" runat="server" Height="40px" ImageUrl="~/Images/shopping-cart.png" Width="40px" PostBackUrl="~/Customer/Cart.aspx" />
                    </td>
                    <td style="text-align: center">
                        <asp:ImageButton ID="ImageButton3" runat="server" Height="40px" ImageUrl="~/Images/exit.png" Width="40px" PostBackUrl="~/User/Home.aspx" />
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                        <asp:Menu ID="Menu1" runat="server" Orientation="Horizontal" RenderingMode="Table" Width="100%" Height="35px" BackColor="#339966" ForeColor="White" style="text-align: center;text-align: center; font-family: sans-serif; font-size: 20px; font-weight: 400">
                            <Items>
                                <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/Customer/Home.aspx"></asp:MenuItem>
                                <asp:MenuItem Text="My Profile" Value="My Profile" NavigateUrl="~/Customer/Myprofile.aspx"></asp:MenuItem>
                                <asp:MenuItem Text="Product" Value="Product" NavigateUrl="~/Customer/Product.aspx"></asp:MenuItem>
                                <asp:MenuItem Text="My Order" Value="My Order" NavigateUrl="~/Customer/Myorder.aspx"></asp:MenuItem>
                                <asp:MenuItem NavigateUrl="~/Customer/CancleOrder.aspx" Text="Cancle Order" Value="Cancle Order"></asp:MenuItem>
                                <asp:MenuItem Text="Feedback" Value="Feedback" NavigateUrl="~/Customer/Feedback.aspx"></asp:MenuItem>
                            </Items>
                        </asp:Menu>
                    </td>
                </tr>
                <tr>
                    <td colspan="4">&nbsp;
                        
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            
        </asp:ContentPlaceHolder>
                    </td>
                </tr>
                <tr>
                    <td colspan="4">
                         <marquee scrollamount ="10" style="background-color: #339966; color:white;text-align: center; font-family: sans-serif; font-size: 20px; font-weight: 400" behaviour ="alternate">Project By Sagar & Shubham <asp:Button ID="Button1" runat="server" Text="b" AccessKey="b" style="background-color: #339966; color:#339966" BorderStyle="None" PostBackUrl="~/Admin/Adminlogin.aspx" Visible="True" /></marquee>

                    </td>
                </tr>
            </table>
    </div>
    </form>
</body>
</html>
